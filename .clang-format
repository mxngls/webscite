BasedOnStyle: WebKit

# Use tabs instead of spaces
# AlignWithSpaces: tabs indent, spaces pad alignment (holds at any tab width)
UseTab: AlignWithSpaces
TabWidth: 8
IndentWidth: 8

# Keep your existing preferences
AlignArrayOfStructures: Left
AlignConsecutiveBitFields: true
AlignConsecutiveMacros: true
# WebKit's default is Never, which collapses trailing comments to one space
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0
ColumnLimit: 100

# Force each parameter on its own line
BinPackParameters: false
AllowAllParametersOfDeclarationOnNextLine: false
AlignAfterOpenBracket: AlwaysBreak

# Keep return type with function name
PenaltyReturnTypeOnItsOwnLine: 10000
